{
  "manifest_version": 3,
  "name": "Swipey",
  "version": "0.2.0",
  "description": "Листает TikTok, YouTube Shorts и Instagram Reels и считает, сколько роликов просмотрено и сколько времени на них ушло.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://www.youtube.com/*",
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://www.youtube.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/content/adapters.js",
        "src/content/tracker.js",
        "src/content/autoscroll.js",
        "src/content/overlay.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-autoscroll": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Включить или выключить автопрокрутку"
    },
    "toggle-overlay": {
      "suggested_key": { "default": "Alt+H" },
      "description": "Скрыть или показать плашку"
    },
    "next-video": {
      "suggested_key": { "default": "Alt+N" },
      "description": "Следующий ролик"
    }
  }
}
